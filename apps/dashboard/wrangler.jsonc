{
  "name": "aegis",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-24",
  "keep_vars": true,
  "services": [
    { "binding": "AEGIS_API", "service": "aegis-api" }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  }
}
