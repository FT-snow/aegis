# Copy to apps/worker/.dev.vars for local Worker development.
# Never commit real credentials.
APP_ENV=local
LAB_ENABLED=true
ALLOWED_CHAIN_IDS=84532,31337
ARE_LOW_MAX=29
ARE_MODERATE_MAX=59
ARE_HIGH_MAX=79
OPENROUTER_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
RPC_URL=
BUNDLER_URL=
BUNDLER_FALLBACK_URL=
AEGIS_FACTORY_ADDRESS=
AEGIS_ACCOUNT_ADDRESS=
ENTRY_POINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032
# Base Sepolia official USDC. For a local 31337 run, use the address of a local USDC mock
# and set ALLOWED_CHAIN_IDS=31337 for that environment.
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7c
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
AGENT_TOKEN_PEPPER=
SESSION_ENCRYPTION_KEY=
# Comma-separated origins allowed to call this API with cookies (dashboard dev origins are
# enabled automatically when APP_ENV=local). Set your production dashboard origin here.
DASHBOARD_ORIGINS=
X402_PAY_TO=
X402_FACILITATOR_URL=
X402_PRICE=$0.001
