# Add these as Worker secrets, never as Pages build variables.
OPENROUTER_API_KEY=<your-OpenRouter-key>
RPC_URL=<your-Base-Sepolia-RPC-URL>
BUNDLER_URL=<your-v0.7-compatible-bundler-URL>
BUNDLER_FALLBACK_URL=
TURSO_DATABASE_URL=<your-Turso-libsql-URL>
TURSO_AUTH_TOKEN=<your-Turso-auth-token>
AGENT_TOKEN_PEPPER=<generate-a-random-secret-at-least-32-characters>
SESSION_ENCRYPTION_KEY=<generate-a-random-secret>
